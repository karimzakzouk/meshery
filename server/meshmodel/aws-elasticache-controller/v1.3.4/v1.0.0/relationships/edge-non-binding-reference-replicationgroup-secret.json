{
  "id": "00000000-0000-0000-0000-000000000000",
  "schemaVersion": "relationships.meshery.io/v1alpha3",
  "version": "v1.0.0",
  "kind": "edge",
  "type": "non-binding",
  "subType": "reference",
  "evaluationQuery": "edge_non_binding_reference_relationship",
  "status": "enabled",
  "metadata": {
    "description": "Reference relationship from AWS ElastiCache ReplicationGroup to Kubernetes Secret. Represents applications referencing ElastiCache Redis credentials (auth token, password) via Kubernetes Secrets."
  },
  "model": {
    "schemaVersion": "models.meshery.io/v1beta1",
    "version": "v1.0.0",
    "name": "aws-elasticache-controller",
    "registrant": {
      "kind": "artifacthub"
    },
    "category": {
      "name": "Provisioning"
    },
    "displayName": "AWS ElastiCache Controller"
  },
  "selectors": [
    {
      "allow": {
        "from": [
          {
            "kind": "ReplicationGroup",
            "model": {
              "name": "aws-elasticache-controller",
              "registrant": {
                "kind": "artifacthub"
              }
            },
            "patch": {
              "patchStrategy": "replace",
              "mutatorRef": [
                ["displayName"]
              ],
              "description": "ElastiCache ReplicationGroup identity can be referenced by Kubernetes secrets-based configuration."
            }
          }
        ],
        "to": [
          {
            "kind": "Secret",
            "model": {
              "name": "kubernetes",
              "registrant": {
                "kind": "artifacthub"
              }
            },
            "patch": {
              "patchStrategy": "replace",
              "mutatedRef": [
                ["data"]
              ],
              "description": "Secret data can store ElastiCache Redis auth token or password used for authenticating connections to the replication group."
            }
          }
        ]
      },
      "deny": {
        "from": [],
        "to": []
      }
    }
  ]
